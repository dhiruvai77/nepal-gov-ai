# Hosted generation
GEMINI_API_KEY=

# Hosted multilingual E5 embeddings
HF_TOKEN=

# Hosted BGE reranker
HF_RERANKER_ENDPOINT_URL=

# Direct/local execution defaults to the local Qdrant service.
QDRANT_URL=http://localhost:6333

# Optional for authenticated remote Qdrant deployments.
QDRANT_API_KEY=

# Host port used by Docker Compose.
APP_PORT=8000